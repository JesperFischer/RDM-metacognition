  pages = {12--23},
  issn = {1364-6613},
  doi = {10.1016/j.tics.2020.10.007},
  url = {https://www.sciencedirect.com/science/article/pii/S1364661320302539},
  urldate = {2026-02-28},
  abstract = {Confidence judgments are typically less informative about one’s accuracy than they could be; a phenomenon we call metacognitive inefficiency. We review the existence of different sources of metacognitive inefficiency and classify them into four categories based on whether the corruption is due to: (i) systematic or nonsystematic influences, and (ii) the input to or the computation of the metacognitive system. Critically, the existence of different sources of metacognitive inefficiency provides an alternative explanation for behavioral findings typically interpreted as evidence for domain-specific (and against domain-general) metacognitive systems. We argue that, contrary to the dominant assumption in the field, metacognitive failures are not monolithic and suggest that understanding the sources of metacognitive inefficiency should be a primary goal of the science of metacognition.},
  keywords = {confidence,metacognition,metacognitive inefficiency,metacognitive noise,perceptual decision making},
